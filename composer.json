{
    "name": "finest/platform-client",
    "description": "What every Laravel service of the Finest platform needs: identity's tokens, events through an outbox to NATS and back, organizations kept apart, prefixed public ids.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "basis-company/nats": "^1.2",
        "firebase/php-jwt": "^7.2",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Finest\\Platform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Finest\\Platform\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Finest\\Platform\\PlatformServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
